#!/usr/bin/env python3
"""Execute Clang's HIP action graph with distributed compilation and links."""
import asyncio
import errno
import json
import os
from pathlib import Path
import shlex
import shutil
import signal
import subprocess
import sys
import tempfile


def option(args, name):
    return args[args.index(name) + 1] if name in args else None


def without(args, options):
    result = []
    words = iter(args)
    for arg in words:
        if arg in options:
            for _ in range(options[arg]):
                next(words)
        else:
            result.append(arg)
    return result


async def child(args, env):
    process = await asyncio.create_subprocess_exec(
        *args, env=env, start_new_session=True,
        stdout=asyncio.subprocess.PIPE, stderr=asyncio.subprocess.PIPE)
    try:
        stdout, stderr = await process.communicate()
    finally:
        if process.returncode is None:
            os.killpg(process.pid, signal.SIGTERM)
            await process.wait()
    if process.returncode:
        raise subprocess.CalledProcessError(process.returncode, args, stdout, stderr)
    sys.stdout.buffer.write(stdout)
    sys.stderr.buffer.write(stderr)


def publish(source, destination):
    try:
        os.replace(source, destination)
        return
    except OSError as error:
        if error.errno != errno.EXDEV:
            raise
    fd, staging = tempfile.mkstemp(prefix='.distcc-', dir=Path(destination).parent)
    os.close(fd)
    try:
        shutil.copyfile(source, staging)
        os.replace(staging, destination)
    finally:
        Path(staging).unlink(missing_ok=True)


def compile_images(source, output, args):
    helper = Path(__file__).resolve().with_name('distcc-offload-link')
    env = dict(os.environ)
    env.pop('_DISTCC_SAFEGUARD', None)
    env.pop('INCLUDE_SERVER_PORT', None)
    with tempfile.TemporaryDirectory(prefix='distcc-offload-') as temporary:
        work = Path(temporary)
        env['TMPDIR'] = temporary
        plan = subprocess.run([*args, '-###'], capture_output=True, text=True, env=env, check=True)
        commands = [shlex.split(line) for line in plan.stderr.splitlines()
                    if line.lstrip().startswith('"')]
        result = work / 'result.o'
        nodes = []

        def add(command, remote, extra_outputs=()):
            artifact = option(command, '-o') or next(
                (arg.partition('=')[2] for arg in command if arg.startswith('-output=')), None)
            if artifact is None:
                raise ValueError('driver action has no output: ' + shlex.join(command))
            # Driver-generated intermediate names are unique. A reference to
            # a preceding output, including --image=file=..., orders that edge.
            dependencies = [i for i, node in enumerate(nodes)
                            if any(name in arg for name in node['outputs'] for arg in command)]
            nodes.append({'args': command, 'outputs': [artifact, *extra_outputs],
                          'remote': remote, 'dependencies': dependencies})

        for index, command in enumerate(commands):
            command = [str(result) if i and command[i - 1] == '-o' and arg == output else
                       '-output=' + str(result) if arg == '-output=' + output else arg
                       for i, arg in enumerate(command)]
            name = Path(command[0]).name
            frontend = '-cc1' in command
            if frontend and option(command, '-x') == 'hip':
                # A bare driver -E in the new HIP driver produces only host
                # text. Each cc1 action has its own target macros and includes.
                # Keep Clang's resolved frontend options, changing only action,
                # input language and the output owned by this coordinator.
                prepared = str(work / f'{index}.hipi')
                cpp = without(command, {'-emit-obj': 0, '-emit-llvm-bc': 0,
                                        '-emit-llvm': 0, '-S': 0,
                                        '-fcuda-include-gpubinary': 1, '-o': 1})
                dependency = option(cpp, '-dependency-file')
                # Use the existing local preprocessing admission, releasing
                # it before asking the broker for a remote compilation slot.
                add([str(helper.with_name('distcc')), *cpp, '-E', '-o', prepared], False,
                    [dependency] if dependency else [])
                command = without(command, {'-dependency-file': 1, '-MT': 1,
                                            '-MQ': 1, '-sys-header-deps': 0,
                                            '-MP': 0, '-MG': 0, '-include': 1,
                                            '-imacros': 1, '-include-pch': 1,
                                            '-I': 1, '-isystem': 1, '-iquote': 1,
                                            '-internal-isystem': 1, '-internal-externc-isystem': 1,
                                            '-idirafter': 1, '-F': 1, '-iframework': 1})
                command[command.index('-x') + 1] = 'hip-cpp-output'
                command[-1] = prepared
            if name == 'clang-linker-wrapper':
                wrapper = helper.with_name('distcc-linker-wrapper')
                command = [str(wrapper), '--device-distributor=' + str(helper),
                           '--device-compiler-path=' + str(Path(args[0]).absolute()),
                           *command[1:]]
            add(command, frontend or name in ('lld', 'ld.lld'))

        async def execute():
            async def action(index, node):
                for predecessor in node['dependencies']:
                    await tasks[predecessor]
                command = node['args']
                if node['remote']:
                    # cc1 bitcode, profile and embedded GPU inputs are explicit
                    # operands. Ship existing file operands through the shared
                    # cache; include directories are irrelevant after -E.
                    inputs = []
                    for arg in command[1:]:
                        value = arg.partition('=')[2] if arg.startswith('-') and '=' in arg else arg
                        if value not in node['outputs'] and not value.startswith('-') and Path(value).is_file():
                            inputs.append(value)
                    request = work / f'{index}.json'
                    request.write_text(json.dumps({'common': {'args': [], 'inputs': []},
                        'jobs': [{'args': command, 'inputs': inputs, 'outputs': node['outputs']}]}))
                    command = [str(helper), str(request)]
                await child(command, env)
            tasks = [asyncio.create_task(action(i, node)) for i, node in enumerate(nodes)]
            try:
                await asyncio.gather(*tasks)
            finally:
                for task in tasks:
                    if not task.done():
                        task.cancel()
                await asyncio.gather(*tasks, return_exceptions=True)

        asyncio.run(execute())
        publish(result, output)
    return 0


if __name__ == '__main__':
    def interrupted(signum, frame):
        raise SystemExit(128 + signum)
    signal.signal(signal.SIGTERM, interrupted)
    try:
        sys.exit(compile_images(*sys.argv[1:3], sys.argv[3:]))
    except subprocess.CalledProcessError as error:
        if error.stdout:
            sys.stdout.buffer.write(error.stdout if isinstance(error.stdout, bytes) else error.stdout.encode())
        if error.stderr:
            sys.stderr.buffer.write(error.stderr if isinstance(error.stderr, bytes) else error.stderr.encode())
        sys.exit(error.returncode if error.returncode > 0 else 128 - error.returncode)
    except (OSError, ValueError, IndexError, StopIteration) as error:
        print('distcc-offload: ' + str(error), file=sys.stderr)
        sys.exit(1)
