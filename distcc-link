class LocalOnly(Exception):
    pass


COMPILER = re.compile(r"(?:[A-Za-z0-9_.+-]+-)?(?P<driver>gcc|g\+\+|clang|clang\+\+)(?:-\d+(?:\.\d+)*)?\Z")
KEY = re.compile(r"[0-9a-f]{64}\Z")
SAFE_FLAGS = {
    '-shared', '-static', '-pie', '-no-pie', '-pthread', '-rdynamic', '-s',
    '-static-libgcc', '-static-libstdc++', '-shared-libgcc', '-fuse-ld=bfd',
    '-fuse-ld=gold', '-fuse-ld=lld', '-fopenmp', '-fopenacc', '-fPIC', '-fpic',
    '-fPIE', '-fpie', '-fno-PIE', '-fno-pie', '-fno-lto', '-nostdlib',
    '-nodefaultlibs', '-nostartfiles', '-ffat-lto-objects', '-fno-fat-lto-objects',
    '-pipe', '-w', '-ffunction-sections', '-fdata-sections', '-fno-plt',
    '-fno-semantic-interposition', '-fomit-frame-pointer', '-fno-omit-frame-pointer',
    '-fasynchronous-unwind-tables', '-fno-asynchronous-unwind-tables',
    '-funwind-tables', '-fno-unwind-tables', '-fcommon', '-fno-common',
}
SAFE_LINKER_FLAGS = {
    '--as-needed', '--no-as-needed', '--gc-sections', '--no-gc-sections',
    '--start-group', '--end-group', '-(', '-)', '--whole-archive',
    '--no-whole-archive', '-Bstatic', '-Bdynamic', '--enable-new-dtags',
    '--disable-new-dtags', '--eh-frame-hdr', '--export-dynamic', '--no-undefined',
    '--fatal-warnings', '--no-fatal-warnings', '--strip-all', '--strip-debug',
    '--no-add-needed', '--copy-dt-needed-entries', '--no-copy-dt-needed-entries',
}


def compiler_family(compiler):
    match = COMPILER.fullmatch(Path(compiler).name)
    if not match:
        raise LocalOnly('unsupported compiler')
    return 'clang' if match['driver'].startswith('clang') else 'gcc'


def query_fingerprint(command):
    """Bounded metadata dependencies; unknown configurations remain uncached."""
    executable = shutil.which(str(command[0]))
    if not executable:
        return None
    executable = Path(executable).resolve()
    if not executable.is_relative_to('/usr'):
        return None
    with executable.open('rb') as stream:
        if stream.read(4) != b'\x7fELF':
            return None
    states = {}

    def stamp(path):
        path = Path(path)
        if str(path) in states:
            return
        if len(states) >= 2048:
            raise ValueError('too many configuration dependencies')
        try:
            info = path.stat()
            states[str(path)] = (info.st_dev, info.st_ino, info.st_size,
                                 info.st_mtime_ns, info.st_ctime_ns)
            if str(path) == '/proc/self/ns/mnt':
                states[str(path)] = (info.st_dev, info.st_ino)
        except FileNotFoundError:
            states[str(path)] = None

    def configuration(path, depth=0):
        if depth > 8:
            raise ValueError('configuration nesting limit')
        path = path.resolve()
        if str(path) in states:
            return
        stamp(path)
        if not path.exists():
            return
        if path.stat().st_size > 65536:
            raise ValueError('configuration too large')
        for arg in shlex.split(path.read_text(), comments=True):
            if arg.startswith('@'):
                if any(c in arg for c in '<>$'):
                    raise ValueError('unsupported configuration substitution')
                configuration(path.parent / arg[1:], depth + 1)
            elif arg.startswith(('--config', '-specs', '--specs', '-B')):
                raise ValueError('custom toolchain configuration')

    stamp(executable)
    stamp('/proc/self/ns/mnt')
    stamp('/')
    for directory in os.get_exec_path():
        stamp(directory or '.')
    family = executable.name
    if 'clang' in family:
        for root in (Path('/etc/clang'), Path.home() / '.config/clang', executable.parent):
            stamp(root)
            if root.is_dir():
                # Standard system configuration plus one version directory.
                for path in sorted(root.iterdir()):
                    if path.suffix == '.cfg':
                        configuration(path)
                    elif root == Path('/etc/clang') and path.is_dir():
                        stamp(path)
                        for config in sorted(path.glob('*.cfg')):
                            configuration(config)
    elif 'gcc' in family or 'g++' in family:
        root = Path('/usr/lib/gcc')
        stamp(root)
        for target in sorted(root.glob('*')):
            if target.is_dir():
                stamp(target)
                for version in sorted(target.glob('*')):
                    if version.is_dir():
                        stamp(version)
                        if (version / 'specs').exists():
                            return None
    environment = {k: v for k, v in os.environ.items()
                   if not k.startswith('DISTCC_') and k not in
                   ('_', 'SANDBOX_LOG', 'SANDBOX_DEBUG_LOG', 'SANDBOX_MESSAGE_P@TH')}
    if 'LD_PRELOAD' in environment:
        for library in filter(None, re.split(r'[ :]+', environment['LD_PRELOAD'])):
            if library not in ('libsandbox.so', 'libjemalloc.so'):
                return None
            for directory in ('/usr/lib64', '/lib64', '/usr/lib', '/lib'):
                stamp(Path(directory) / library)
    if any(k in environment for k in ('GCC_EXEC_PREFIX', 'COMPILER_PATH', 'CCC_OVERRIDE_OPTIONS',
                                      'LD_LIBRARY_PATH')):
        return None
    return json.dumps([command, os.getcwd(), environment, states], sort_keys=True)


def compiler_query(command):
    """Share successful metadata probes across short-lived link helpers.

    The server has no scheduling broker. A private, bounded on-disk cache with
    per-slot flock works on both ends without adding a daemon or subprocess.
    Errors and unfamiliar toolchains take the ordinary query path.
    """
    def query():
        return subprocess.check_output(command, text=True)

    try:
        fingerprint = query_fingerprint(command)
        if fingerprint is None:
            return query()
        digest = hashlib.sha256(fingerprint.encode()).hexdigest()
        directory = Path(tempfile.gettempdir()) / ('distcc-query-' + str(os.geteuid()))
        directory.mkdir(mode=0o700, exist_ok=True)
        info = directory.lstat()
        if not stat.S_ISDIR(info.st_mode) or info.st_uid != os.geteuid() or info.st_mode & 0o077:
            return query()
        # Fixed slots bound storage and make locking survive process exits.
        fd = os.open(directory / str(int(digest[:8], 16) % 64),
                     os.O_RDWR | os.O_CREAT | os.O_NOFOLLOW | os.O_CLOEXEC, 0o600)
        with os.fdopen(fd, 'r+') as stream:
            info = os.fstat(stream.fileno())
            if not stat.S_ISREG(info.st_mode) or info.st_uid != os.geteuid() or info.st_mode & 0o077:
                return query()
            fcntl.flock(stream, fcntl.LOCK_EX)
            try:
                saved = json.loads(stream.read(65536))
                if saved.get('key') == digest and isinstance(saved.get('value'), str):
                    return saved['value']
            except (ValueError, AttributeError):
                pass
            value = query()
            if len(value) < 32768 and query_fingerprint(command) == fingerprint:
                stream.seek(0)
                stream.truncate()
                json.dump({'key': digest, 'value': value}, stream)
            return value
    except (OSError, ValueError):
        return query()


def compiler_identity(compiler, target=None):
    clang = compiler_family(compiler) == 'clang'
    command = [compiler, *(['--target=' + target] if clang and target else [])]
    return {
        'target': compiler_query([*command, '-dumpmachine']).strip(),
        'version': compiler_query([compiler, '-dumpversion' if clang else '-dumpfullversion']).strip(),
    }


def clang_link_args(command, version):
    """Let the client's driver resolve configuration, runtimes and LTO flags.

    Only a single LLD invocation is distributable. Source compilation and
    offload pipelines still run locally with the original command.
    """
    result = subprocess.run([command[0], '-###', *command[1:]], capture_output=True, text=True)
    commands = [shlex.split(line) for line in result.stderr.splitlines()
                if line.lstrip().startswith('"')]
    if (result.returncode or len(commands) != 1 or not commands[0] or
            not re.fullmatch(r'ld\.lld(?:-\d+)?', Path(commands[0][0]).name)):
        raise LocalOnly('Clang remote links require a single LLD invocation')
    check_lld_version(commands[0][0], version)
    return commands[0][1:]


def check_lld_version(linker, version):
    description = compiler_query([str(linker), '--version'])
    if not re.search(r'\bLLD\s+' + re.escape(version) + r'(?:\s|$)', description):
        raise LocalOnly('Clang and LLD versions differ')


def lld_for(compiler, version):
    linker = compiler_query([compiler, '-print-prog-name=ld.lld']).strip()
    check_lld_version(linker, version)
    return str(linker)


def response_args(args, depth=0):
    if depth > 8:
        raise LocalOnly('response file nesting limit')
    expanded = []
    for arg in args:
        if arg.startswith('@'):
            text = Path(arg[1:]).read_text()
            if len(text) > 1024 * 1024:
                raise LocalOnly('response file too large')
            expanded.extend(response_args(shlex.split(text, comments=False), depth + 1))
        else:
            expanded.append(arg)
    return expanded


def linker_flags(arg):
    """Keep runtime paths verbatim; unhandled link-time paths stay local."""
    words = iter(arg[4:].split(','))
    for word in words:
        if word in SAFE_LINKER_FLAGS or re.fullmatch(
                r'(?:-O[0-3]|--hash-style=(?:gnu|sysv|both)|--build-id(?:=[A-Za-z0-9]+)?)', word):
            continue
        if word == '-z':
            if next(words, '') in ('now', 'lazy', 'relro', 'norelro', 'defs', 'nodefs',
                                    'noexecstack', 'execstack', 'origin'):
                continue
        elif word in ('-rpath', '--rpath', '-soname', '--soname', '-h'):
            if next(words, ''):
                continue
        elif word.startswith(('--rpath=', '--soname=')):
            continue
        raise LocalOnly('unsupported linker option: ' + word)
    return arg


def validate_input(path):
    with path.open('rb') as stream:
        magic = stream.read(8)
    if magic == b'!<thin>\n':
        raise LocalOnly('thin archives require their referenced files')
    if magic[:4] not in (b'\x7fELF', b'BC\xc0\xde', b'\xde\xc0\x17\x0b') and magic != b'!<arch>\n':
        raise LocalOnly('linker scripts require their referenced files')


def prepare_job(command, profile, identity=None):
    compiler, *args = command
    args = response_args(args)
    if any(arg in ('-m16', '-m32', '-mx32', '-mabi=ilp32') for arg in args):
        raise LocalOnly('non-default multilib links are not supported')
    target = None
    for index, arg in enumerate(args):
        if arg in ('-target', '--target'):
            if index + 1 == len(args):
                raise LocalOnly('missing target')
            target = args[index + 1]
        elif arg.startswith(('--target=', '-target=')):
            target = arg.split('=', 1)[1]
    identity = identity or compiler_identity(compiler, target)
    if any(identity[k] != profile[k] for k in identity):
        raise LocalOnly('compiler and sysroot profile differ')
    if compiler_family(compiler) != profile.get('family', 'gcc'):
        raise LocalOnly('compiler family and sysroot profile differ')
    if compiler_family(compiler) == 'gcc' and any(
            arg in ('-march=native', '-mtune=native', '-mcpu=native') for arg in args):
        raise LocalOnly('GCC native object links require client-side CPU expansion')
    if not KEY.fullmatch(profile['key']):
        raise LocalOnly('invalid sysroot key')
    if compiler_family(compiler) == 'clang':
        args = clang_link_args([compiler, *args], identity['version'])
    return map_link_job(compiler, args, profile, identity)


def map_link_job(compiler, args, profile, identity, source_root=None):
    clang = compiler_family(compiler) == 'clang'
    mapped, inputs, file_names, library_dirs = [], {}, {}, {}
    output = 'a.out'
    index = 0

    def cached_path(value):
        root = Path(source_root or os.environ.get('DISTCC_LINK_SOURCE', '/')).absolute()
        path = Path(os.path.normpath(value)).absolute()
        name = str(path.relative_to(root)) if path.is_relative_to(root) else str(path).lstrip('/')
        resolved, _ = resolve_inside(root, name)
        return resolved if resolved in profile['state'] else None

    def input_file(value, archive_name=None):
        path = Path(value).absolute()
        cached = cached_path(value) if clang and archive_name is None else None
        if cached:
            return {'sysroot_input': cached}
        if not path.is_file() or not re.search(r'\.(?:o|a|lo|so(?:\.[A-Za-z0-9_.-]+)?)$', path.name):
            raise LocalOnly('unsupported link input: ' + value)
        validate_input(path)
        key = str(path)
        if archive_name is None:
            if '.so' in path.suffixes:
                raise LocalOnly('explicit shared-library paths may be recorded in DT_NEEDED')
            if key not in file_names:
                file_names[key] = f'input-{len(file_names)}{path.suffix}'
            archive_name = file_names[key]
        inputs[archive_name] = key
        return {'input': archive_name}

    while index < len(args):
        arg = args[index]
        index += 1
        if arg in ('-m32', '-mabi=ilp32'):
            raise LocalOnly('non-default multilib links are not supported')
        if arg == '-o':
            if index == len(args):
                raise LocalOnly('missing output')
            output = args[index]
            index += 1
        elif arg.startswith('-o') and len(arg) > 2:
            output = arg[2:]
        elif arg == '-L' or arg.startswith('-L'):
            value = arg[2:]
            if not value:
                if index == len(args):
                    raise LocalOnly('missing library directory')
                value = args[index]
                index += 1
            cached = cached_path(value) if clang else None
            if cached or value in ('/lib', '/lib64', '/usr/lib', '/usr/lib64'):
                mapped.append({'library_dir': '/' + cached if cached else value})
            else:
                directory = Path(value).absolute()
                key = str(directory)
                if not directory.is_dir():
                    if clang:
                        continue  # Driver search paths can include absent directories.
                    raise LocalOnly('library search directory does not exist')
                if key not in library_dirs:
                    library_dirs[key] = 'library-' + str(len(library_dirs))
                    for file in sorted(directory.iterdir()):
                        if re.fullmatch(r'lib[A-Za-z0-9_+.-]+\.(?:a|so(?:\.[A-Za-z0-9_.-]+)?)', file.name):
                            input_file(str(file), library_dirs[key] + '/' + file.name)
                mapped.append({'library_tree': library_dirs[key]})
        elif not arg.startswith('-'):
            mapped.append(input_file(arg))
        elif clang:
            if arg in ('-m', '-dynamic-linker', '--dynamic-linker', '-z',
                       '-rpath', '--rpath', '-soname', '--soname', '-h'):
                if index == len(args) or not args[index] or args[index].startswith('-'):
                    raise LocalOnly('missing linker option value')
                value = args[index]
                index += 1
                if arg == '-m':
                    if value not in ('aarch64linux', 'aarch64linuxb', 'elf_x86_64', 'elf_i386',
                                     'armelf_linux_eabi', 'elf64lriscv', 'elf64lppc', 'elf64ppc'):
                        raise LocalOnly('unsupported linker emulation')
                elif arg == '-z':
                    linker_flags('-Wl,-z,' + value)
                mapped.extend((arg, value))
            elif arg in SAFE_LINKER_FLAGS or arg in ('-pie', '-shared', '-static', '-s', '-EL', '-EB') or re.fullmatch(
                    r'(?:-l[A-Za-z0-9_+.:-]+|-O[0-3]|--hash-style=(?:gnu|sysv|both)'
                    r'|--?(?:icf=(?:none|safe|all)|(?:no-)?undefined-version)'
                    r'|--(?:threads=[1-9][0-9]*|lto-O[0-3])'
                    r'|--build-id(?:=[A-Za-z0-9]+)?|-plugin-opt=(?:O[0-3]|thinlto|-enable-tlsdesc|mcpu=[A-Za-z0-9_.+-]+))', arg):
                mapped.append(arg)
            else:
                raise LocalOnly('unsupported LLD option: ' + arg)
        elif arg in SAFE_FLAGS or re.fullmatch(
                r'(?:-O[0-3sgz]|-g(?:[0-3]|gdb[0-3]?)?|-flto(?:=(?:auto|jobserver|\d+))?'
                r'|-l[A-Za-z0-9_+.:-]+|-m(?:arch|cpu|tune|abi)=[A-Za-z0-9_.+-]+'
                r'|-m(?:32|64)|-f(?:no-)?(?:exceptions|rtti|stack-protector(?:-strong|-all)?))', arg):
            mapped.append(arg)
        elif arg.startswith('-Wl,'):
            mapped.append(linker_flags(arg))
        elif arg == '-I' or arg == '-isystem' or arg == '-include' or arg == '-D' or arg == '-U':
            if index == len(args):
                raise LocalOnly('missing preprocessing argument')
            index += 1
        elif arg.startswith(('-I', '-D', '-U')):
            pass  # Pure object links do not preprocess source files.
        elif arg.startswith('-W') and not arg.startswith('-Wp,'):
            pass  # Driver diagnostics have no effect on an object-only link.
        else:
            raise LocalOnly('unsupported link option: ' + arg)
    if not inputs or output == '-' or len(mapped) > 10000:
        raise LocalOnly('not a supported file-producing object link')
    job = dict(identity, key=profile['key'], compiler=Path(compiler).name, args=mapped)
    return job, inputs, Path(output)


def file_state(path):
    info = path.lstat()
    kind = stat.S_IFMT(info.st_mode)
    return [kind, info.st_mtime_ns, info.st_ctime_ns,
            None if stat.S_ISDIR(info.st_mode) else info.st_size]


def check_source(profile, root=None):
    root = Path(root if root is not None else os.environ.get('DISTCC_LINK_SOURCE', '/'))
    for name, expected in profile['state'].items():
        if Path(name).is_absolute() or '..' in Path(name).parts:
            raise ValueError('invalid sysroot state path')
        try:
            current = file_state(root / name)
        except FileNotFoundError:
            current = None
        if current != expected:
            raise LocalOnly('sysroot changed; synchronize a new snapshot before remote linking')


def receive_exact(sock, size):
    data = bytearray()
    while len(data) < size:
        part = sock.read(min(size - len(data), 65536))
        if not part:
            raise OSError('link server disconnected')
        data.extend(part)
    return bytes(data)


def token(sock, name):
    header = receive_exact(sock, 12)
    if header[:4] != name.encode('ascii'):
        raise OSError('unexpected link protocol token')
    return int(header[4:], 16)


def copy_response(sock, name, stream, codec=None):
    size = token(sock, name)
    if codec and size:
        if size != 0xffffffff:
            raise OSError('invalid chunked link payload')
        copy_lz4(lambda size: receive_exact(sock, size), stream, codec)
        return
    while size:
        data = receive_exact(sock, min(size, 65536))
        stream.write(data)
        size -= len(data)


def copy_lz4(read, destination, codec, limit=None):
    """Decode bounded chunks, checking the exact expansion when known."""
    total = 0
    while True:
        header = read(8)
        if len(header) != 8:
            raise OSError('truncated LZ4 header')
        plain, encoded = struct.unpack('!II', header)
        if not plain and not encoded:
            if limit is not None and total != limit:
                raise OSError('incomplete LZ4 result')
            return
        if (not 0 < plain <= codec.chunk_size or encoded >= plain or
                (limit is not None and plain > limit - total)):
            raise OSError('invalid LZ4 chunk size')
        data = read(encoded or plain)
        if len(data) != (encoded or plain):
            raise OSError('truncated LZ4 chunk')
        destination.write(codec.decode(data, plain) if encoded else data)
        total += plain


class Lz4Chunks:
    """The same bounded block format as the C RPC bulk transport."""
    chunk_size = 256 * 1024

    def __init__(self):
        import ctypes
        self.ctypes = ctypes
        self.library = ctypes.CDLL('liblz4.so.1')
        signature = (ctypes.c_char_p, ctypes.c_void_p, ctypes.c_int, ctypes.c_int)
        self.library.LZ4_compress_default.argtypes = signature
        self.library.LZ4_compress_default.restype = ctypes.c_int
        self.library.LZ4_decompress_safe.argtypes = signature
        self.library.LZ4_decompress_safe.restype = ctypes.c_int
        self.library.LZ4_compressBound.argtypes = (ctypes.c_int,)
        self.library.LZ4_compressBound.restype = ctypes.c_int
        self.bound = self.library.LZ4_compressBound(self.chunk_size)
        self.buffer = ctypes.create_string_buffer(self.bound)

    def encode(self, data):
        n = self.library.LZ4_compress_default(data, self.buffer, len(data), self.bound)
        if n <= 0:
            raise OSError('LZ4 compression failed')
        if n >= len(data):
            return struct.pack('!II', len(data), 0) + data
        return struct.pack('!II', len(data), n) + self.ctypes.string_at(self.buffer, n)

    def decode(self, data, size):
        n = self.library.LZ4_decompress_safe(data, self.buffer, len(data), size)
        if n != size:
            raise OSError('invalid LZ4 chunk')
        return self.ctypes.string_at(self.buffer, n)


class ChunkWriter:
    def __init__(self, stream, codec):
        self.stream, self.codec = stream, codec
        self.pending = bytearray()

    def write(self, data):
        self.pending.extend(data)
        while len(self.pending) >= self.codec.chunk_size:
            chunk = bytes(self.pending[:self.codec.chunk_size])
            del self.pending[:self.codec.chunk_size]
            self.stream.write(self.codec.encode(chunk))
        return len(data)

    def finish(self):
        if self.pending:
            self.stream.write(self.codec.encode(bytes(self.pending)))
            self.pending.clear()
        self.stream.write(bytes(8))


class LinkArchive:
    """Plan the length-prefixed tar from metadata, then stream each input once."""

    def __init__(self, job, inputs):
        self.data = json.dumps(job).encode()
        self.members = []
        self.size = 2 * tarfile.BLOCKSIZE  # End-of-archive records.
        self.add('job.json', len(self.data), None, None)
        for name, path in inputs.items():
            stat = os.stat(path)
            self.add(name, stat.st_size, path, self.identity(stat))
        self.size += -self.size % tarfile.RECORDSIZE
        if self.size > 0xffffffff:
            raise LocalOnly('link inputs exceed the protocol size limit')

    @staticmethod
    def identity(stat):
        return (stat.st_dev, stat.st_ino, stat.st_size, stat.st_mtime_ns, stat.st_ctime_ns)

    def add(self, name, size, path, identity):
        member = tarfile.TarInfo(name)
        member.size = size
        self.members.append((member, path, identity))
        self.size += len(member.tobuf(format=tarfile.PAX_FORMAT))
        self.size += size + (-size % tarfile.BLOCKSIZE)

    def send(self, sock, codec=None):
        with sock.makefile('wb', buffering=65536) as raw:
            self.write(raw, codec)

    def write(self, raw, codec=None):
        stream = ChunkWriter(raw, codec) if codec else raw
        with tarfile.open(fileobj=stream, mode='w|', format=tarfile.PAX_FORMAT) as tar:
            for member, path, identity in self.members:
                if path is None:
                    tar.addfile(member, io.BytesIO(self.data))
                    continue
                with open(path, 'rb') as source:
                    if self.identity(os.fstat(source.fileno())) != identity:
                        raise OSError('link input changed before transfer')
                    tar.addfile(member, source)
                    if self.identity(os.fstat(source.fileno())) != identity:
                        raise OSError('link input changed during transfer')
        if codec:
            stream.finish()


def tcp_link(net, archive, output):
    """Stream a link archive and receive one bounded pooled TCP transaction."""
    begin, need, incoming, result_type, outgoing, complete = range(0x54000200, 0x54000206)
    compressed, final = 0x10000, 0x20000
    codec = Lz4Chunks()
    identity = int.from_bytes(os.urandom(8), 'big') or 1

    def string(value):
        value = value.encode()
        return struct.pack('!Q', len(value)) + value

    def send(kind, body):
        net.sendall(struct.pack('!II', kind, len(body)) + body)

    def exact(size):
        chunks = bytearray()
        while len(chunks) < size:
            part = net.recv(size - len(chunks))
            if not part:
                raise OSError('truncated TCP link response')
            chunks.extend(part)
        return bytes(chunks)

    def receive():
        kind, size = struct.unpack('!II', exact(8))
        if size > codec.chunk_size + 8:
            raise OSError('oversized TCP link response')
        return kind, exact(size)

    metadata = (struct.pack('!3Q', 2, 1, 1) + string(os.getcwd()) + string('distcc-link') +
                struct.pack('!5Q', 0, 0, 0, archive.size, archive.size) + bytes(8) +
                string('/input.tar') + string(''))
    send(begin, struct.pack('!Q', identity) + metadata)

    class Writer:
        def __init__(self):
            self.pending = bytearray()
            self.sent = 0

        def write(self, data):
            self.pending.extend(data)
            while len(self.pending) >= codec.chunk_size:
                self.flush_chunk(codec.chunk_size)
            return len(data)

        def flush_chunk(self, amount):
            data = bytes(self.pending[:amount])
            del self.pending[:amount]
            encoded = codec.encode(data)
            plain, packed = struct.unpack('!II', encoded[:8])
            self.sent += plain
            if self.sent > archive.size:
                raise OSError('link input length changed')
            send(incoming | (compressed if packed else 0) |
                 (final if self.sent == archive.size else 0),
                 struct.pack('!II', 0, plain) + encoded[8:])

    writer = Writer()
    archive.write(writer)
    if writer.pending:
        writer.flush_chunk(len(writer.pending))
    if writer.sent != archive.size:
        raise OSError('link input length changed')
    kind, body = receive()
    if kind != result_type or len(body) != 64:
        raise OSError('invalid TCP link result')
    status, mode, *sizes = struct.unpack('!II4Q', body[:40])
    if status > 65535 or mode > 0o777 or sum(sizes) > 512 * 1024 * 1024:
        raise OSError('invalid TCP link result sizes')
    with tempfile.NamedTemporaryFile(dir=output.absolute().parent,
                                     prefix='.distcc-link-', delete=False) as artifact:
        temporary = Path(artifact.name)
        try:
            received = [0] * 4
            finished = [size == 0 for size in sizes]
            while True:
                kind, body = receive()
                if kind == complete:
                    if body != struct.pack('!Q', identity) or not all(finished):
                        raise OSError('incomplete TCP link result')
                    break
                if kind & ~(compressed | final) != outgoing or len(body) < 8:
                    raise OSError('invalid TCP link artifact')
                index, plain = struct.unpack('!II', body[:8])
                data = body[8:]
                if index >= 4 or finished[index] or not 0 < plain <= codec.chunk_size:
                    raise OSError('invalid TCP link chunk')
                if kind & compressed:
                    if len(data) >= plain:
                        raise OSError('invalid compressed TCP link chunk')
                    data = codec.decode(data, plain)
                elif len(data) != plain:
                    raise OSError('invalid raw TCP link chunk')
                received[index] += plain
                if received[index] > sizes[index]:
                    raise OSError('oversized TCP link artifact')
                if index == 0:
                    sys.stderr.buffer.write(data)
                elif index == 1:
                    sys.stdout.buffer.write(data)
                elif index == 2:
                    artifact.write(data)
                else:
                    raise OSError('unexpected link dependency artifact')
                if kind & final:
                    if received[index] != sizes[index]:
                        raise OSError('truncated TCP link artifact')
                    finished[index] = True
            if not status:
                mask = os.umask(0)
                os.umask(mask)
                os.fchmod(artifact.fileno(), mode & ~mask)
                artifact.flush()
                os.replace(temporary, output)
        finally:
            temporary.unlink(missing_ok=True)
    return status


def remote_link(job, inputs, output):
    archive = LinkArchive(job, inputs)
    with ExitStack() as stack:
        lease = stack.enter_context(socket.socket(socket.AF_UNIX, socket.SOCK_SEQPACKET))
        lease.connect(os.environ['DISTCC_BROKER'])
        lease.sendall(struct.pack('=II', 2, 8))
        reply, ancillary, flags, _ = lease.recvmsg(1032, socket.CMSG_SPACE(4),
                                                   socket.MSG_CMSG_CLOEXEC)
        descriptors = []
        for level, kind, data in ancillary:
            if (level, kind) == (socket.SOL_SOCKET, socket.SCM_RIGHTS):
                descriptors.extend(array.array('i', data))
        try:
            if len(reply) != 1032 or flags & (socket.MSG_TRUNC | socket.MSG_CTRUNC):
                raise OSError('invalid broker reply')
            status, capabilities = struct.unpack('=ii', reply[:8])
            if len(descriptors) != 1:
                raise OSError('invalid broker descriptors')
            if status:
                raise OSError('broker has no available link host')
            host = reply[8:].split(b'\0', 1)[0].decode()
            if ',auth' in host:
                raise LocalOnly('authenticated link protocol is not supported')
            lease.sendall(struct.pack('=II', 2, 3))
            options = set(host.split(','))
            if 'tcp' in options:
                with socket.socket(fileno=descriptors.pop()) as net:
                    net.settimeout(float(os.environ.get('DISTCC_IO_TIMEOUT', '300')))
                    status = tcp_link(net, archive, output)
                    try:
                        lease.sendmsg([struct.pack('=II3Q', 2, 7, 0, 0, 0)],
                                      [(socket.SOL_SOCKET, socket.SCM_RIGHTS,
                                        array.array('i', [net.fileno()]))])
                    except OSError:
                        pass
                if os.environ.get('DISTCC_VERBOSE') == '1':
                    print('distcc-link: linked on ' + host, file=sys.stderr)
                code = os.waitstatus_to_exitcode(status)
                if code == 100:
                    raise OSError('remote link worker could not execute the job')
                return code if code >= 0 else 128 - code
            codec = Lz4Chunks() if 'lz4s' in options else None
            version = 10 if codec else 4
            net = socket.socket(fileno=descriptors.pop())
            with net, net.makefile('rb', buffering=65536) as response:
                net.settimeout(float(os.environ.get('DISTCC_IO_TIMEOUT', '300')))
                net.sendall(f'DIST{version:08x}LINK{0xffffffff if codec else archive.size:08x}'.encode())
                archive.send(net, codec)
                if token(response, 'DONE') != version:
                    raise OSError('unsupported link protocol version')
                status = token(response, 'STAT')
                copy_response(response, 'SERR', sys.stderr.buffer, codec)
                copy_response(response, 'SOUT', sys.stdout.buffer, codec)
                mode = token(response, 'MODE')
                with tempfile.NamedTemporaryFile(dir=output.absolute().parent,
                                                 prefix='.distcc-link-', delete=False) as result:
                    temporary = Path(result.name)
                    try:
                        copy_response(response, 'DOTO', result, codec)
                        if capabilities & (1 << 30) and token(response, 'JEND') != 0:
                            raise OSError('invalid end of pooled job')
                        if not status:
                            mask = os.umask(0)
                            os.umask(mask)
                            os.fchmod(result.fileno(), mode & 0o777 & ~mask)
                            result.flush()
                            os.replace(temporary, output)
                    finally:
                        temporary.unlink(missing_ok=True)
                if capabilities & (1 << 30):
                    try:
                        lease.sendmsg([struct.pack('=II3Q', 2, 7, 0, 0, 0)],
                                      [(socket.SOL_SOCKET, socket.SCM_RIGHTS,
                                        array.array('i', [net.fileno()]))])
                    except OSError:
                        pass  # Losing the pool does not invalidate a completed link.
                if os.environ.get('DISTCC_VERBOSE') == '1':
                    print('distcc-link: linked on ' + host, file=sys.stderr)
                code = os.waitstatus_to_exitcode(status)
                if code == 100:
                    raise OSError('remote link worker could not execute the job')
                return code if code >= 0 else 128 - code
        finally:
            for fd in descriptors:
                os.close(fd)


def worker(archive, output):
    root = Path(os.environ['DISTCCD_LINK_ROOT'])
    with tempfile.TemporaryDirectory(prefix='distcc-link-') as name:
        work = Path(name)
        with tarfile.open(archive, mode='r:') as tar:
            names = set()
            for member in tar:
                if (not member.isfile() or member.name in names or len(names) >= 100000 or
                    not re.fullmatch(r'(?:job\.json|input-\d+\.(?:o|a|so|lo)|'
                                     r'library-\d+/lib[A-Za-z0-9_+.-]+\.(?:a|so(?:\.[A-Za-z0-9_.-]+)?))',
                                     member.name)):
                    raise ValueError('invalid link archive member')
                names.add(member.name)
                if member.name == 'job.json' and member.size > 1024 * 1024:
                    raise ValueError('link request metadata too large')
                path = work / member.name
                path.parent.mkdir(exist_ok=True)
                with tar.extractfile(member) as source, path.open('wb') as target:
                    shutil.copyfileobj(source, target, 65536)
                if member.name != 'job.json':
                    validate_input(path)
        job = json.loads((work / 'job.json').read_text())
        key = job['key']
        if not isinstance(key, str) or not KEY.fullmatch(key):
            raise ValueError('invalid sysroot key')
        sysroot = root / key
        profile = json.loads((sysroot / '.distcc-link.json').read_text())
        if profile.get('format') != 1 or profile.get('key') != key:
            raise ValueError('invalid cached sysroot profile')
        compiler = job['compiler']
        if not isinstance(compiler, str) or Path(compiler).name != compiler:
            raise ValueError('invalid compiler name')
        clang = compiler_family(compiler) == 'clang'
        if compiler_family(compiler) != profile.get('family', 'gcc'):
            raise ValueError('compiler family does not match the sysroot')
        identity = compiler_identity(compiler, profile['target'])
        if any(identity[k] != job[k] or identity[k] != profile[k] for k in identity):
            raise ValueError('link compiler does not match the sysroot')
        gccdir = profile.get('gccdir', '')
        if not clang and not re.fullmatch(r'usr/lib(?:64)?/gcc/[A-Za-z0-9_.+-]+/[A-Za-z0-9_.+-]+', gccdir):
            raise ValueError('invalid GCC runtime directory')
        args = []
        for arg in job['args']:
            if isinstance(arg, dict) and set(arg) == {'input'} and arg['input'] in names:
                args.append(str(work / arg['input']))
            elif isinstance(arg, dict) and set(arg) in ({'library_dir'}, {'sysroot_input'}):
                option, value = next(iter(arg.items()))
                if not isinstance(value, str):
                    raise ValueError('invalid cached input path')
                relative = value.lstrip('/') if option == 'library_dir' else value
                if (Path(relative).is_absolute() or '..' in Path(relative).parts or
                    (relative not in profile['state'] and value not in ('/lib', '/lib64', '/usr/lib', '/usr/lib64'))):
                    raise ValueError('input is not in the cached sysroot')
                args.append(('-L' if option == 'library_dir' else '') + str(sysroot / relative))
            elif (isinstance(arg, dict) and set(arg) == {'library_tree'} and
                  isinstance(arg['library_tree'], str) and re.fullmatch(r'library-\d+', arg['library_tree'])):
                directory = work / arg['library_tree']
                directory.mkdir(exist_ok=True)
                args.append('-L' + str(directory))
            elif isinstance(arg, str):
                operand = clang and args and args[-1] in (
                    '-m', '-dynamic-linker', '--dynamic-linker', '-z',
                    '-rpath', '--rpath', '-soname', '--soname', '-h')
                if (not arg.startswith('-') and not operand) or arg.startswith(('-L', '-o')):
                    raise ValueError('unmapped path in link request')
                args.append(arg)
            else:
                raise ValueError('invalid link argument')
        # Reapply the same allowlist on the server, independent of client trust.
        verify_profile = dict(profile, key=key)
        validation_args = [a for a in args if not a.startswith('-L')]
        map_link_job(compiler, [*validation_args, '-o', output], verify_profile, identity, sysroot)
        # Native client specs can have an empty sysroot_spec; pass the cache
        # to ld explicitly as well as to the GCC driver's library search.
        if clang:
            command = [lld_for(compiler, identity['version']), *args,
                       '--sysroot=' + str(sysroot), '-o', output]
        else:
            command = [compiler, '--sysroot=' + str(sysroot), '-B' + str(sysroot / gccdir) + '/',
                       '-specs=' + str(sysroot / '.distcc-link.specs'),
                       *args, '-Wl,--sysroot=' + str(sysroot), '-o', output]
        result = subprocess.call(command)
        return result if result >= 0 else 128 - result


def resolve_inside(root, name):
    links = []
    for _ in range(40):
        parts = name.split('/')
        for index in range(len(parts)):
            prefix = '/'.join(parts[:index + 1])
            path = root / prefix
            if path.is_symlink():
                links.append(prefix)
                name = posixpath.normpath(posixpath.join(
                    '/' + posixpath.dirname(prefix), os.readlink(path),
                    *parts[index + 1:])).lstrip('/')
                break
        else:
            return name, links
    return None, links  # Preserve dangling/cyclic links without traversing them.


def library_files(root, profile):
    """Project a sysroot to linker inputs, without copying executables or homes.

    Resolve symlinks relative to the supplied root, including absolute links.
    The source must be a stable snapshot for hashing and rsync to agree.
    """
    directories = ['lib', 'lib64', 'usr/lib', 'usr/lib64',
                   'lib/' + profile['target'], 'usr/lib/' + profile['target']]
    if profile.get('gccdir'):
        directories.append(profile['gccdir'])
    directories.extend(profile.get('runtime_dirs', []))
    directories.extend(profile.get('cxx_dirs', []))
    pending = []
    for directory in directories:
        name, links = resolve_inside(root, directory)
        pending.extend(links)
        if name is not None and (root / name).is_dir():
            for child in (root / name).iterdir():
                if directory in profile.get('cxx_dirs', []) and not child.name.startswith(
                        ('libc++', 'libunwind', 'libomp.')):
                    continue
                if child.name == 'specs' or re.search(
                        r'(?:\.so(?:\..*)?|\.a|\.o|\.ld|\.lds|\.spec|\.x[a-z]*)$', child.name):
                    pending.append(str(child.relative_to(root)))
    files, visited = set(), set()
    while pending:
        name, links = resolve_inside(root, pending.pop())
        files.update(links)
        if name is None:
            continue
        if name in visited:
            continue
        visited.add(name)
        path = root / name
        if path.is_file():
            files.add(name)
    return sorted(files)


def sysroot_digest(profile, root, files):
    digest = hashlib.sha256(json.dumps(profile, sort_keys=True).encode())
    for name in files:
        digest.update(os.fsencode(name) + b'\0')
        path = root / name
        if path.is_symlink():
            target = posixpath.normpath(posixpath.join(
                '/' + posixpath.dirname(name), os.readlink(path)))
            digest.update(b'L' + os.fsencode(target) + b'\0')
        else:
            digest.update(b'F')
            with path.open('rb') as stream:
                digest.update(hashlib.file_digest(stream, 'sha256').digest())
    return digest.hexdigest()


def sysroot_identity(root, compiler):
    profile = compiler_identity(compiler)
    clang = compiler_family(compiler) == 'clang'
    runtime = subprocess.check_output([compiler, '-print-file-name=crtbegin.o'], text=True).strip()
    gccdir = Path(os.path.normpath(runtime)).parent.as_posix().lstrip('/')
    if not clang and not (root / gccdir / 'crtbegin.o').is_file():
        # A cross compiler may report paths inside its configured sysroot.
        gccdir = f"usr/lib/gcc/{profile['target']}/{profile['version'].split('.')[0]}"
    if not clang and not (root / gccdir / 'crtbegin.o').is_file():
        raise ValueError('GCC startup objects are missing from the source sysroot')
    profile['format'] = 1
    if (root / gccdir / 'crtbegin.o').is_file():
        profile['gccdir'] = gccdir
    if clang:
        executable = subprocess.check_output([compiler, '-print-prog-name=clang'], text=True).strip()
        prefix = Path(executable).resolve().parent.parent
        runtime = subprocess.check_output([compiler, '-print-runtime-dir'], text=True).strip()
        profile.update(family='clang', runtime_dirs=[os.path.normpath(runtime).lstrip('/')],
                       cxx_dirs=[str(prefix / lib).lstrip('/') for lib in ('lib', 'lib64')])
        lld_for(compiler, profile['version'])
    else:
        profile['specs'] = subprocess.check_output([compiler, '-dumpspecs'], text=True)
    return profile


def sysroot_profile(root, profile, files):
    watched = set(files)
    for name in files:
        parent = Path(name).parent
        while len(parent.parts) >= 1:
            watched.add(str(parent))
            parent = parent.parent
    profile['state'] = {name: file_state(root / name) for name in sorted(watched)}
    profile['key'] = sysroot_digest(profile, root, files)
    return profile


def destination(value):
    if ':' in value:
        host, path = value.split(':', 1)
        if not re.fullmatch(r'[A-Za-z0-9_][A-Za-z0-9_.@-]*', host):
            raise ValueError('use a hostname or SSH configuration alias for the cache destination')
    else:
        host, path = None, value
    if not path.startswith('/') or '..' in Path(path).parts:
        raise ValueError('cache destination must be an absolute path without ..')
    return host, path.rstrip('/') or '/'


def remote_command(host, args):
    if host:
        return ['ssh', '-oBatchMode=yes', host, shlex.join(args)]
    return args


def publish(stage, key):
    stage = Path(stage)
    if not KEY.fullmatch(key) or not stage.name.startswith('.incoming-' + key + '-'):
        raise ValueError('invalid staged cache path')
    profile = json.loads((stage / '.distcc-link.json').read_text())
    if profile['key'] != key:
        raise ValueError('cache profile does not match its generation')
    identity = {k: v for k, v in profile.items() if k != 'key'}
    if sysroot_digest(identity, stage, library_files(stage, profile)) != key:
        raise ValueError('sysroot changed during transfer; use a stable snapshot')
    if profile.get('family', 'gcc') == 'gcc':
        (stage / '.distcc-link.specs').write_text(profile['specs'])
    # Absolute links in the source root must not escape into the worker's root.
    for directory, dirs, files in os.walk(stage, followlinks=False):
        for name in dirs + files:
            path = Path(directory) / name
            if path.is_symlink():
                link = os.readlink(path)
                logical = '/' + str(path.relative_to(stage).parent)
                target = posixpath.normpath(posixpath.join(logical, link)).lstrip('/')
                replacement = os.path.relpath(stage / target, path.parent)
                path.unlink()
                path.symlink_to(replacement)
    final = stage.parent / key
    try:
        stage.rename(final)
    except OSError:
        if not final.is_dir() or json.loads((final / '.distcc-link.json').read_text()) != profile:
            raise
        shutil.rmtree(stage)
    current = final.parent / ('.current-' + uuid.uuid4().hex)
    current.symlink_to(key)
    os.replace(current, final.parent / 'current')


def transfer_generation(source, listing, metadata, key, host, base):
    final = base + '/' + key
    if not subprocess.run(remote_command(host, ['test', '-d', final])).returncode:
        return final
    stage = base + '/.incoming-' + key + '-' + uuid.uuid4().hex
    subprocess.run(remote_command(host, ['mkdir', '-p', stage]), check=True)
    remote_stage = f'{host}:{stage}' if host else stage
    try:
        previous = subprocess.run(remote_command(host, ['test', '-d', base + '/current']))
        link_dest = ['--link-dest=' + base + '/current'] if not previous.returncode else []
        subprocess.run(['rsync', '-az', '--checksum', '--secluded-args', '--from0',
            '--files-from=' + str(listing), *link_dest,
            source.rstrip('/') + '/', remote_stage + '/'], check=True, stdout=sys.stderr)
        subprocess.run(['rsync', '-az', '--secluded-args', str(metadata),
            remote_stage + '/'], check=True, stdout=sys.stderr)
        subprocess.run(remote_command(host, ['distcc-link', '--publish', stage, key]), check=True)
    except BaseException:
        # Only this invocation's unique staging directory is removed.
        subprocess.run(remote_command(host, ['rm', '-rf', '--', stage]), check=False)
        raise
    return final


def describe_sysroot(root, compiler):
    root = Path(root).absolute()
    profile = sysroot_identity(root, compiler)
    files = library_files(root, profile)
    return {'profile': sysroot_profile(root, profile, files), 'files': files}


def sync_sysroot(root, compiler, profile_path, destinations, *, refresh=False):
    source_host, source_path = destination(root)
    targets = [destination(dest) for dest in destinations]
    profile_path = Path(profile_path).absolute()
    if refresh and profile_path.is_file():
        profile = json.loads(profile_path.read_text())
        key = profile['key']
        if not KEY.fullmatch(key):
            raise ValueError('invalid cached sysroot key')
        helper = 'distcc-link' if source_host else str(Path(__file__).resolve())
        check = subprocess.run(remote_command(source_host,
            [helper, '--check', source_path, compiler]),
            input=json.dumps(profile), text=True)
        if check.returncode == 0 and all(subprocess.run(remote_command(host,
                ['test', '-f', base + '/' + key + '/.distcc-link.json'])).returncode == 0
                for host, base in targets):
            print('sysroot ' + key + ' unchanged')
            return
    if source_host:
        local = next((dest for dest in targets if dest[0] is None), None)
        if local is None:
            raise ValueError('a remote source requires a local cache destination for rsync staging')
        description = json.loads(subprocess.check_output(remote_command(source_host,
            ['distcc-link', '--describe', source_path, compiler]), text=True))
    else:
        description = describe_sysroot(source_path, compiler)
    profile, files = description['profile'], description['files']
    key = profile['key']
    if not KEY.fullmatch(key) or any(Path(f).is_absolute() or '..' in Path(f).parts for f in files):
        raise ValueError('invalid remote sysroot description')
    with tempfile.TemporaryDirectory(prefix='distcc-sysroot-') as name:
        scratch = Path(name)
        listing = scratch / 'files'
        listing.write_bytes(b'\0'.join(os.fsencode(f) for f in files) + b'\0')
        metadata = scratch / '.distcc-link.json'
        metadata.write_text(json.dumps(profile, sort_keys=True) + '\n')
        if source_host:
            # Pull once into this controller's cache, then synchronize workers.
            # No credentials need to be forwarded or installed on the source.
            source_path = transfer_generation(root, listing, metadata, key, *local)
            targets.remove(local)
        if targets:
            # Destinations are independent after source preparation.
            # Join every transfer before publishing the profile or
            # removing its temporary metadata, including on failure.
            with ThreadPoolExecutor(max_workers=len(targets)) as pool:
                transfers = [pool.submit(transfer_generation, source_path,
                    listing, metadata, key, host, base) for host, base in targets]
                for transfer in transfers:
                    transfer.result()
    with tempfile.NamedTemporaryFile(mode='w', dir=profile_path.parent,
                                     prefix='.distcc-sysroot-', delete=False) as stream:
        temporary = Path(stream.name)
        try:
            json.dump(profile, stream, sort_keys=True)
            stream.write('\n')
            stream.flush()
            os.fchmod(stream.fileno(), 0o644)
            os.replace(temporary, profile_path)
        finally:
            temporary.unlink(missing_ok=True)
    print('sysroot ' + key + ' ready')


def main():
    if len(sys.argv) == 4 and sys.argv[1] == '--check':
        profile = json.load(sys.stdin)
        try:
            check_source(profile, sys.argv[2])
            identity = compiler_identity(sys.argv[3])
            return int(any(identity[key] != profile[key] for key in identity) or
                       compiler_family(sys.argv[3]) != profile.get('family', 'gcc'))
        except LocalOnly:
            return 1
    if len(sys.argv) == 4 and sys.argv[1] == '--describe':
        print(json.dumps(describe_sysroot(sys.argv[2], sys.argv[3]), sort_keys=True))
        return 0
    if len(sys.argv) >= 6 and sys.argv[1] in ('--sync', '--refresh'):
        try:
            sync_sysroot(sys.argv[2], sys.argv[3], sys.argv[4], sys.argv[5:],
                         refresh=sys.argv[1] == '--refresh')
            return 0
        except (OSError, ValueError, subprocess.SubprocessError) as error:
            print('distcc-link: ' + str(error), file=sys.stderr)
            return 1
    if len(sys.argv) == 4 and sys.argv[1] == '--publish':
        publish(sys.argv[2], sys.argv[3])
        return 0
    if len(sys.argv) == 4 and sys.argv[1] == '--worker':
        try:
            return worker(sys.argv[2], sys.argv[3])
        except (OSError, ValueError, KeyError, TypeError, LocalOnly, subprocess.SubprocessError) as error:
            print('distcc-link: ' + str(error), file=sys.stderr)
            return 100
    command = sys.argv[1:]
    if not command:
        print('usage: distcc-link COMPILER [link options]\n'
              '       distcc-link --sync|--refresh SNAPSHOT COMPILER PROFILE CACHE_DIRECTORY...', file=sys.stderr)
        return 1
    try:
        path = Path(os.environ['DISTCC_LINK_SYSROOT'])
        if path.is_dir():
            path /= compiler_family(command[0]) + '.json'
        profile = json.loads(path.read_text())
        check_source(profile)
        job, inputs, output = prepare_job(command, profile)
        result = remote_link(job, inputs, output)
        if not result or os.environ.get('DISTCC_FALLBACK') == '0':
            return result
        print('distcc-link: remote linker failed; retrying locally', file=sys.stderr)
    except LocalOnly as error:
        if os.environ.get('DISTCC_VERBOSE') == '1':
            print('distcc-link: local: ' + str(error), file=sys.stderr)
    except (OSError, ValueError, KeyError, TypeError, subprocess.SubprocessError) as error:
        print('distcc-link: ' + str(error), file=sys.stderr)
        if os.environ.get('DISTCC_FALLBACK') == '0':
            return 1
    os.environ['DISTCC_LINK_SYSROOT'] = ''
    os.execvp(command[0], command)


if __name__ == '__main__':
    try:
        sys.exit(main())
    except (OSError, ValueError, KeyError, TypeError, LocalOnly, tarfile.TarError,
            subprocess.SubprocessError) as error:
        print('distcc-link: ' + str(error), file=sys.stderr)
        sys.exit(1)
