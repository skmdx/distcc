#!/usr/bin/env python3
"""Link through the local broker using an immutable, rsync-populated sysroot.

The compile fast path stays in C. This helper is started only for object links
when DISTCC_LINK_SYSROOT names a sysroot profile. Unsupported commands retain
the existing local compiler behavior.
"""
import array
from contextlib import ExitStack
from concurrent.futures import ThreadPoolExecutor
import fcntl
