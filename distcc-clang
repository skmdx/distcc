#!/usr/bin/env python3
"""One-shot Clang worker preserving the original source's profile identity."""
import shutil
import sys

from include_server import clang_scan


def main():
    root, original, *command = sys.argv[1:]
    # LibTooling locates resources relative to argv[0], without PATH lookup.
    # Preserve the driver name: resolving symlinks would lose target and mode.
    command[0] = shutil.which(command[0]) or command[0]
    return clang_scan.compile(command, original, root)


if __name__ == '__main__':
    sys.exit(main())
