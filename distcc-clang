#!/usr/bin/env python3
"""Clang execution with isolated jobs and reusable frontend libraries."""
import importlib
import os
import re
import shutil
import subprocess
import sys


def load_frontend(compiler, module='clang_compile'):
    # LibTooling locates resources relative to argv[0], without PATH lookup.
    # Preserve the driver name: resolving symlinks would lose target and mode.
    compiler = shutil.which(compiler) or compiler
    # Remote commands encode the client's release in the driver name, even
    # when the worker does not install a matching version-suffixed symlink.
    release = re.search(r'(?:^|-)clang(?:\+\+)?-(\d+)(?:\.\d+)*$', os.path.basename(compiler))
    if release and module == 'clang_compile':
        major = release.group(1)
    else:
        version = subprocess.check_output([compiler, '-dumpversion'], text=True).strip()
        major = version.split('.')[0]
        if not major.isdecimal():
            raise ValueError('invalid Clang version: ' + version)
    return importlib.import_module('include_server.clang' + major + '.' + module)


def compile_command(arguments, frontend=None):
    root, original, cwd, mode, *command = arguments
    if mode == 'remote':
        descriptor, dependencies, *command = command
    # Captured remote cc1 arguments do not use the driver executable. Native
    # ToolInvocation still needs its resource directory resolved from argv[0].
    if mode != 'remote':
        command[0] = shutil.which(command[0]) or command[0]
    if frontend is None:
        frontend = load_frontend(command[0])
    if mode == 'remote':
        from include_server import distcc_pump_c_extensions as protocol
        request = os.memfd_create('distcc-clang-command')
        try:
            protocol.XArgv(request, ['distcc-clang', *arguments])
            os.lseek(request, 0, os.SEEK_SET)
            return frontend.compile_file(request, int(descriptor))
        finally:
            os.close(request)
    return frontend.compile(command, original, root, cwd, mode == 'pump')


def main():
    if sys.argv[1] == '--native-worker':
        return load_frontend(sys.argv[3], 'clang_native').serve(int(sys.argv[2]))
    if sys.argv[1] == '--worker':
        return load_frontend(sys.argv[3]).serve(int(sys.argv[2]))
    return compile_command(sys.argv[1:])


if __name__ == '__main__':
    sys.exit(main())
