#!/usr/bin/env python3
"""Cargo/rustc wrapper: plan with rustc, execute through distcc's pooled jobs.

Rust libraries are the distribution unit. Executable links and procedural
macros stay on the client, where native libraries and arbitrary macro inputs
are available. No Rust syntax is interpreted by this planner.
"""
import fcntl
import glob
import json
import os
from pathlib import Path
import shutil
import subprocess
import sys
import tarfile
import tempfile
import time


from distcc_job import LocalOnly, stamp, snapshot, fingerprint, write_metadata


VALUES = {'--cap-lints', '--cfg', '--check-cfg', '--crate-name', '--crate-type',
          '--edition', '--error-format', '--extern', '--json', '--remap-path-prefix',
          '--target', '--sysroot', '--emit', '--out-dir', '-o', '-C', '-L', '-l',
          '-A', '-W', '-D', '-F', '--allow', '--warn', '--deny', '--forbid',
          '--force-warn', '--diagnostic-width', '--color', '--codegen'}
RUNTIME = ('/lib', '/lib64', '/usr/lib64', '/usr/lib/gcc', '/usr/lib/llvm',
           '/etc/ld.so.cache')
CONTROL = '/__distcc_rust'
NATIVE_LIBRARY = str(Path(__file__).with_name('distcc-rust-native.so'))


def absolute(value):
    return Path(os.path.abspath(value))


def options(args):
    """Parse rustc's option grammar, never the source language."""
    result = []
    words = iter(args)
    for word in words:
        if word == '--':
            result.extend(('', value) for value in words)
            break
        name, equal, value = word.partition('=')
        if name in VALUES:
            if not equal:
                try:
                    value = next(words)
                except StopIteration:
                    raise LocalOnly('missing option value') from None
            result.append(('-C' if name == '--codegen' else name, value))
        elif word[:2] in {'-C', '-L', '-l', '-A', '-W', '-D', '-F', '-o'} and len(word) > 2:
            result.append((word[:2], word[2:]))
        elif word.startswith('-'):
            # Only options whose operands we relocate need interpretation.
            # rustc validates all remaining flags and their operands.
            result.append((word, None))
        elif word.startswith('@'):
            raise LocalOnly('response file must be expanded before distribution')
        else:
            result.append(('', word))
    return result


def flatten(opts):
    return [part for key, value in opts for part in
            ([key, value] if key and value is not None else [key or value])]


def identity(compiler):
    # Compiler queries and dependency discovery inherit Cargo's jobserver FDs,
    # like the original rustc command. Python-owned files remain CLOEXEC.
    lines = subprocess.check_output([compiler, '-vV'], text=True, close_fds=False).splitlines()
    fields = dict(line.split(': ', 1) for line in lines[1:] if ': ' in line)
    return {'version': lines[0], 'commit': fields.get('commit-hash', ''),
            'llvm': fields.get('LLVM version', '')}, fields['host']


def native_profile(compiler, compiler_id, work):
    """Ask this rustc's LLVM once per compiler/CPU configuration, without
    translating LLVM features into Rust's different target-feature vocabulary.
    """
    executable = Path(shutil.which(compiler) or compiler).resolve()
    library = Path(NATIVE_LIBRARY).resolve()
    key = json.dumps([str(executable), stamp(executable.stat()), compiler_id,
                      str(library), stamp(library.stat()),
                      Path('/proc/sys/kernel/random/boot_id').read_text(),
                      sorted(os.sched_getaffinity(0)), os.environ.get('LD_PRELOAD', ''),
                      os.environ.get('LD_LIBRARY_PATH', '')])
    directory = Path(os.environ.get('DISTCC_DIR', Path.home() / '.distcc'))
    directory.mkdir(parents=True, exist_ok=True)
    with (directory / 'rust-native.json').open('a+') as cache:
        fcntl.flock(cache, fcntl.LOCK_EX)
        cache.seek(0)
        try:
            saved = json.load(cache)
        except json.JSONDecodeError:
            saved = {}
        if saved.get('key') == key:
            return saved['profile']
        capture = work / 'native'
        capture.mkdir()
        preload = ' '.join(filter(None, (str(library), os.environ.get('LD_PRELOAD'))))
        env = dict(os.environ, LD_PRELOAD=preload,
                   DISTCC_RUST_NATIVE=str(capture), DISTCC_RUST_NATIVE_CAPTURE='1')
        probe = subprocess.run([compiler, '-Ctarget-cpu=native', '--print=cfg'],
                               env=env, capture_output=True, close_fds=False)
        if probe.returncode:
            raise LocalOnly('native CPU discovery failed: ' + probe.stderr.decode(errors='replace'))
        profile = {name: (capture / name).read_text() for name in ('cpu', 'features')}
        cache.seek(0)
        cache.truncate()
        json.dump(dict(key=key, profile=profile), cache)
        return profile


def dependencies(path):
    # Our dep-info-only probe emits one target followed by one phony rule per
    # input. Read those records instead of applying shell/Make escaping rules:
    # rustc escapes spaces, but leaves dollars, quotes and backslashes literal.
    # env-dep records name the variables observed by env!/option_env!.
    text = path.read_text()
    files = []
    _, separator, records = text.partition('\n\n')
    if not separator:
        raise LocalOnly('rustc did not produce dependency records')
    for record in records.splitlines():
        if not record or record.startswith('# env-dep:'):
            continue
        if not record.endswith(':'):
            raise LocalOnly('unsupported dependency record')
        files.append(absolute(record[:-1].replace('\\ ', ' ')))
    if not files:
        raise LocalOnly('rustc did not produce dependency records')
    environment = {}
    for line in text.splitlines():
        if line.startswith('# env-dep:'):
            name = line[len('# env-dep:'):].partition('=')[0]
            if name in os.environ:
                environment[name] = os.environ[name]
    return files, environment


def plan(compiler, args, work):
    opts = options(args)
    if ('-', None) in opts or ('', '-') in opts:
        raise LocalOnly('standard input requires local compilation')
    values = dict(opts)
    emits = values.get('--emit', 'link').split(',')
    types = set(values.get('--crate-type', 'bin').split(','))
    if 'proc-macro' in types or (any(e.split('=')[0] == 'link' for e in emits)
                                and not types <= {'lib', 'rlib'}):
        raise LocalOnly('executable/native linking or procedural macro')
    if all(e.split('=')[0] == 'dep-info' for e in emits):
        raise LocalOnly('dependency query')
    compiler_id, host = identity(compiler)
    target = values.get('--target', host)
    root = absolute(values.get('--sysroot') or subprocess.check_output(
        [compiler, '--print=sysroot'], text=True, close_fds=False).strip())
    inputs = set()
    libraries = set()
    if target.endswith('.json'):
        inputs.add(absolute(target))
    for key, value in opts:
        if key == '-C' and value.startswith('profile-use='):
            inputs.add(absolute(value.partition('=')[2]))
        elif key == '--extern':
            _, equal, file = value.partition('=')
            if equal:
                if Path(file).suffix == '.so':
                    raise LocalOnly('procedural macro or dynamic Rust dependency')
                inputs.add(absolute(file))
        elif key == '-L':
            kind, equal, directory = value.partition('=')
            directory = absolute(directory if equal else kind)
            if directory.is_dir():
                # rustc names the actual Rust dependency closure below. Search
                # directories can contain every crate built so far; copying all
                # of them makes a small crate transfer gigabytes of unrelated
                # input. Native archives are not part of binary dep-info.
                if not equal or kind not in ('dependency', 'crate'):
                    inputs.update(p for p in directory.iterdir() if p.suffix == '.a')
                libraries.update(p.resolve() for p in directory.iterdir() if p.suffix == '.so')
    # A client dep-info pass expands modules/includes using the actual compiler
    # and caller environment. A failure goes back through the original command.
    base = [(k, v) for k, v in opts if k not in ('--emit', '--out-dir', '-o')
            and not (k == '-C' and v.partition('=')[0] == 'incremental')]
    loaded = work / 'loaded-libraries'
    loaded.write_bytes(b'')
    start = time.time_ns()
    with loaded.open('ab') as trace:
        os.set_inheritable(trace.fileno(), True)
        probe_env = dict(os.environ, RUSTC_BOOTSTRAP='1', DISTCC_RUST_LOADS_FD=str(trace.fileno()),
                         LD_PRELOAD=NATIVE_LIBRARY + ' ' + os.environ.get('LD_PRELOAD', ''))
        # Bootstrap is scoped to dependency discovery; the actual compilation
        # retains the caller's feature policy and options.
        probe = subprocess.run([compiler, *flatten(base), '-Zbinary-dep-depinfo',
                                '--emit=dep-info=' + str(work / 'probe.d')],
                               stdout=subprocess.PIPE, stderr=subprocess.PIPE, close_fds=False, env=probe_env)
    if probe.returncode:
        raise LocalOnly('dependency expansion failed')
    if any(Path(os.fsdecode(name)).resolve() in libraries for name in loaded.read_bytes().split(b'\0') if name):
        raise LocalOnly('procedural macro executed through a transitive dependency')
    source_files, environment = dependencies(work / 'probe.d')
    inputs.update(source_files)
    if 'RUSTC_BOOTSTRAP' in os.environ:
        environment['RUSTC_BOOTSTRAP'] = os.environ['RUSTC_BOOTSTRAP']
    outdir = absolute(values.get('--out-dir', '.'))
    output = work / 'out'
    output.mkdir()
    mapped = list(base)
    if '--sysroot' not in values:
        mapped.append(('--sysroot', str(root)))
    if '--target' not in values:
        mapped.append(('--target', target))
    outputs = {}
    mapped_emits = []
    for emit in emits:
        kind, equal, path = emit.partition('=')
        if equal:
            destination = absolute(path)
            if path == '-' or not destination.parent.is_dir():
                raise LocalOnly('non-file output')
            name = destination.name
            if name in outputs and outputs[name] != str(destination):
                raise LocalOnly('colliding output filenames')
            outputs[name] = str(destination)
            mapped_emits.append(kind + '=' + str(output / name))
        else:
            mapped_emits.append(kind)
    mapped.append(('--emit', ','.join(mapped_emits)))
    if '-o' not in values or '--out-dir' in values:
        mapped.append(('--out-dir', str(output)))
    if '-o' in values:
        dest = absolute(values['-o'])
        if values['-o'] == '-' or str(dest).startswith('/dev/'):
            raise LocalOnly('non-file output')
        mapped.append(('-o', str(output / dest.name)))
        outdir = dest.parent
    job = dict(compiler=compiler_id, cwd=os.getcwd(), args=flatten(mapped),
               environment=environment, output=str(output))
    codegen = dict(v.split('=', 1) for k, v in opts if k == '-C' and '=' in v)
    if codegen.get('target-cpu') == 'native':
        job['native'] = native_profile(compiler, compiler_id, work)
    # Files that changed during dependency discovery require a new invocation;
    # never combine one dependency graph with another generation's contents.
    states = {}
    for path in inputs:
        info = path.stat()
        if not path.is_file() or max(info.st_mtime_ns, info.st_ctime_ns) > start:
            raise LocalOnly('input changed during dependency discovery')
        if path == Path(CONTROL) or str(path).startswith(CONTROL + '/') or any(
                path == Path(p) or path.is_relative_to(p) for p in (*RUNTIME, '/dev', '/proc', '/sys')):
            raise LocalOnly('input overlaps the worker runtime')
        states[path] = stamp(info)
    return job, states, outdir, outputs


def metadata(job, inputs, work):
    snapshots = work / 'inputs'
    snapshots.mkdir()
    entries = []

    def add(name, dest):
        entries.append((name, *fingerprint(dest)))

    for name, expected in sorted(inputs.items()):
        dest = snapshots / str(len(entries))
        snapshot(name, dest, expected)
        add(str(name), dest)
    manifest = snapshots / str(len(entries))
    manifest.write_text(json.dumps(job))
    add(CONTROL + '/job.json', manifest)
    write_metadata(3, job['cwd'], 'distcc-rust', entries, work / 'job')
    return work / 'job', snapshots


def worker_compilers(requested):
    # Prefer the client's build, but let rustc and the eventual client link
    # decide compatibility. Version/LLVM differences are not rejection gates.
    # Executables still come from administrator-installed toolchains.
    configured = os.environ.get('DISTCCD_RUSTC')
    candidates = configured.split(os.pathsep) if configured else [shutil.which('rustc')]
    if not configured:
        candidates += glob.glob('/usr/lib/rust/*/bin/rustc') + glob.glob('/opt/rust-*/bin/rustc')
    ranked = []
    for candidate in dict.fromkeys(Path(p).resolve() for p in candidates if p):
        try:
            actual = identity(candidate)[0]
            score = (actual == requested, actual['commit'] == requested['commit'],
                     actual['version'] == requested['version'],
                     actual['llvm'] == requested['llvm'])
            if actual == requested:
                # Keep the common case to one compiler query. Discover other
                # candidates only if rustc rejects the input metadata.
                yield candidate
            else:
                ranked.append((score, candidate))
        except (OSError, subprocess.CalledProcessError):
            continue
    for _, candidate in sorted(ranked, key=lambda item: item[0], reverse=True):
        yield candidate


def incompatible_metadata(diagnostics):
    for line in diagnostics:
        if line.startswith(b'{'):
            try:
                code = json.loads(line).get('code')
            except (ValueError, AttributeError):
                continue
            if isinstance(code, dict) and code.get('code') == 'E0514':
                return True
        elif b'error[E0514]' in line:
            return True
    return False


def worker(root, archive):
    root = Path(root)
    job = json.loads((root / CONTROL.lstrip('/') / 'job.json').read_text())
    def rooted(name):
        path = Path(name)
        if not path.is_absolute() or '..' in path.parts:
            raise LocalOnly('invalid input path')
        return root / str(path).lstrip('/')
    # Revalidate the compilation action. Codegen option validity belongs to
    # rustc, so compiler updates do not require a second option allowlist here.
    opts = options(job['args'])
    vals = dict(opts)
    types = set(vals.get('--crate-type', 'bin').split(','))
    emits = vals.get('--emit', 'link').split(',')
    if 'proc-macro' in types or (any(e.split('=')[0] == 'link' for e in emits)
                                and not types <= {'lib', 'rlib'}):
        raise LocalOnly('unsupported worker action')
    output = Path(job['output'])
    cwd = Path(job['cwd'])
    for path in (output, cwd):
        if not path.is_absolute() or '..' in path.parts or (path == output and str(path) == '/'):
            raise LocalOnly('invalid worker path')
        (root / str(path).lstrip('/')).mkdir(parents=True, exist_ok=True)
    # Bypass user PATH wrappers: namespace isolation and separate diagnostic
    # streams are part of the worker contract.
    sandbox = [shutil.which('bwrap', path=os.defpath) or '/usr/bin/bwrap',
               '--unshare-all', '--die-with-parent', '--bind', str(root), '/',
               '--bind', str(rooted(str(output))), str(output)]
    for path in RUNTIME:
        if Path(path).exists():
            sandbox.extend(['--ro-bind', path, path])
    sandbox.extend(['--proc', '/proc', '--dev', '/dev', '--tmpfs', '/tmp',
                    '--chdir', str(cwd), '--clearenv'])
    for name, value in job['environment'].items():
        if name.startswith(('LD_', 'DYLD_')) or name in ('RUSTC_WRAPPER', 'RUSTC_WORKSPACE_WRAPPER'):
            raise LocalOnly('unsafe worker environment')
        sandbox.extend(['--setenv', name, value])
    native = job.get('native')
    if native is not None:
        profile = rooted(CONTROL + '/native')
        profile.mkdir()
        for name in ('cpu', 'features'):
            value = native[name]
            if not isinstance(value, str) or '\0' in value:
                raise LocalOnly('invalid native CPU profile')
            (profile / name).write_text(value)
        sandbox.extend(['--ro-bind', NATIVE_LIBRARY, CONTROL + '/native.so',
                        '--bind', str(profile), CONTROL + '/native',
                        '--setenv', 'LD_PRELOAD', CONTROL + '/native.so',
                        '--setenv', 'DISTCC_RUST_NATIVE', CONTROL + '/native',
                        '--setenv', 'DISTCC_RUST_NATIVE_CAPTURE', '0'])
    # Let bwrap create mount points, then protect shared input inodes. This
    # remount is nonrecursive: output, /tmp and native markers stay writable.
    directory = rooted(str(output))
    result = None
    with tempfile.TemporaryFile() as stdout, tempfile.TemporaryFile() as stderr:
        for compiler in worker_compilers(job['compiler']):
            if result is not None:
                for path in directory.iterdir():
                    if path.is_dir() and not path.is_symlink():
                        shutil.rmtree(path)
                    else:
                        path.unlink()
            for stream in (stdout, stderr):
                stream.seek(0)
                stream.truncate()
            if native is not None:
                for name in ('cpu-used', 'features-used'):
                    (profile / name).unlink(missing_ok=True)
            result = subprocess.run([*sandbox, '--ro-bind', str(compiler.parent.parent),
                CONTROL + '/compiler', '--remount-ro', '/',
                CONTROL + '/compiler/bin/rustc', *job['args']], stdout=stdout, stderr=stderr)
            stderr.seek(0)
            if result.returncode == 0 or not incompatible_metadata(stderr):
                break
        if result is None:
            raise LocalOnly('no worker Rust compiler is installed')
        # Do not publish failed attempts' artifact notifications or diagnostics.
        for source, destination in ((stdout, sys.stdout.buffer), (stderr, sys.stderr.buffer)):
            source.seek(0)
            shutil.copyfileobj(source, destination)
            destination.flush()
    if result.returncode:
        return result.returncode if result.returncode > 0 else 128 - result.returncode
    if native is not None and not all((profile / (name + '-used')).exists()
                                      for name in ('cpu', 'features')):
        raise LocalOnly('worker rustc did not consume the client native CPU profile')
    with tarfile.open(archive, 'w') as tar:
        for path in sorted(directory.iterdir()):
            if not path.is_file() or path.is_symlink():
                raise LocalOnly('unexpected Rust output')
            tar.add(path, arcname=path.name, recursive=False)
    return 0


def install_outputs(archive, job, outdir, outputs, work):
    staged = work / 'received'
    staged.mkdir()
    # Validate every member before publishing any result. No extractall and no
    # paths/symlinks controlled by a worker are ever applied to the client tree.
    planned = []
    seen = set()
    with tarfile.open(archive) as tar:
        for member in tar:
            if not member.isfile() or '/' in member.name or member.name in ('', '.', '..') or member.name in seen:
                raise OSError('invalid Rust result archive')
            seen.add(member.name)
            dest = Path(outputs.get(member.name, str(outdir / member.name)))
            if not dest.parent.is_dir():
                raise OSError('Rust output directory does not exist')
            file = staged / member.name
            with tar.extractfile(member) as src, file.open('wb') as dst:
                shutil.copyfileobj(src, dst, 256 * 1024)
            if file.suffix == '.d':
                text = file.read_text()
                for name, path in outputs.items():
                    text = text.replace(job['output'] + '/' + name, path)
                file.write_text(text.replace(job['output'], str(outdir)))
            planned.append((file, dest, member.mode))
    if not planned:
        raise OSError('empty Rust result archive')
    for file, dest, mode in planned:
        with tempfile.NamedTemporaryFile(dir=dest.parent, prefix='.distcc-rust-', delete=False) as tmp:
            temporary = Path(tmp.name)
            try:
                with file.open('rb') as source:
                    shutil.copyfileobj(source, tmp, 256 * 1024)
                mask = os.umask(0)
                os.umask(mask)
                os.fchmod(tmp.fileno(), mode & 0o777 & ~mask)
                tmp.flush()
                os.replace(temporary, dest)
            finally:
                temporary.unlink(missing_ok=True)


def client(compiler, args):
    try:
        if not os.environ.get('DISTCC_BROKER'):
            raise LocalOnly('Rust distribution requires DISTCC_BROKER')
        with tempfile.TemporaryDirectory(prefix='distcc-rust-') as directory:
            work = Path(directory)
            job, inputs, outdir, outputs = plan(compiler, args, work)
            description, snapshots = metadata(job, inputs, work)
            env = dict(os.environ)
            env.pop('INCLUDE_SERVER_PORT', None)
            transport = str(Path(__file__).resolve().with_name('distcc'))
            result = subprocess.run([transport, '--file-job', str(description), str(snapshots),
                                     str(work / 'result.tar')], env=env,
                                    stdout=subprocess.PIPE, stderr=subprocess.PIPE)
            if (result.returncode and os.environ.get('DISTCC_FALLBACK') != '0'
                    and os.environ.get('DISTCC_SKIP_LOCAL_RETRY') != '1'):
                raise LocalOnly('worker compilation failed; retrying locally')
            if result.returncode >= 100 or result.returncode < 0:
                raise OSError(result.stderr.decode(errors='replace').strip() or 'Rust worker failed')
            if not result.returncode:
                install_outputs(work / 'result.tar', job, outdir, outputs, work)
            # Cargo starts dependent crates as soon as it reads rustc's JSON
            # artifact notifications, before this wrapper exits.
            for data, stream in ((result.stdout, sys.stdout.buffer), (result.stderr, sys.stderr.buffer)):
                stream.write(data.replace(os.fsencode(job['output']), os.fsencode(outdir)))
            return result.returncode
    except LocalOnly as error:
        if os.environ.get('DISTCC_VERBOSE') == '1':
            print('distcc-rust: local: ' + str(error), file=sys.stderr)
    except (OSError, ValueError, subprocess.CalledProcessError, tarfile.TarError) as error:
        print('distcc-rust: ' + str(error), file=sys.stderr)
        if os.environ.get('DISTCC_FALLBACK') == '0':
            return 100
    os.execvp(compiler, [compiler, *args])


def main():
    if len(sys.argv) == 4 and sys.argv[1] == '--worker':
        try:
            return worker(sys.argv[2], sys.argv[3])
        except (LocalOnly, OSError, ValueError, KeyError) as error:
            print('distcc-rust: worker: ' + str(error), file=sys.stderr)
            return 100
    if len(sys.argv) < 2:
        print('usage: distcc-rust RUSTC [arguments] (or RUSTC_WRAPPER=distcc-rust cargo build)', file=sys.stderr)
        return 1
    return client(sys.argv[1], sys.argv[2:])


if __name__ == '__main__':
    sys.exit(main())
