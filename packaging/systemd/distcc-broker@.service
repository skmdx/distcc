[Unit]
Description=Local distcc scheduling broker for %i
Requires=distcc-broker@%i.socket
After=network.target

[Service]
User=%i
ExecStart=/usr/bin/distccd --broker /run/distcc-broker-%i.socket
Environment=DISTCC_DIR=/var/cache/distcc-broker-%i
CacheDirectory=distcc-broker-%i
MemoryMax=64M
MemorySwapMax=0
NoNewPrivileges=yes
